# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build output (never commit)
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
LAUNCH_CHECKLIST.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment secrets (commit env.example as the template)
.env*
!.env.example
!env.example

# source screenshots for npm run optimize-images (commit .webp outputs only)
public/projects/*.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
